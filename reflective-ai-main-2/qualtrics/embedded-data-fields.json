        "recaptcha_action_matches",
        "recaptcha_hostname",
        "recaptcha_challenge_ts",
        "recaptcha_error_codes"
      ]
    },
    {
      "name": "chatbot_metadata",
      "fields": [
        "conversation_id",
        "transcript_url",
        "chat_completed",
        "chat_turn_count",
        "chat_min_user_turns",
        "chat_max_user_turns",
        "completion_reason",
        "chat_started_at",
        "chat_completed_at",
        "chat_duration_ms"
      ]
    },
    {
      "name": "postchat_widgets",
      "fields": [
        "motive_total",
        "allocation_label_order",
        "allocation_democrat",
        "allocation_republican",
        "allocation_interacted"
      ]
